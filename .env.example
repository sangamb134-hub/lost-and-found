# Environment configuration for Lost and Found Management System
# Copy this file to .env and fill in real values. Never commit .env.

# Flask secret key (use a long random string in production)
SECRET_KEY=change-this-to-a-long-random-secret-key

# Database URL
# SQLite for local development:
DATABASE_URL=sqlite:///lostfound.db
# PostgreSQL for production (Render provides this as a postgres:// URL):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# File upload settings
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=app/static/uploads

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1
